<Window x:Class="NexusBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS BOOST" Height="920" Width="1510" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="#070B16">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1528"/>
            <Setter Property="BorderBrush" Value="#1C3157"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#080F20" BorderBrush="#1C3157" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="✦ NEXUS BOOST" FontSize="22" FontWeight="ExtraBold" Foreground="#76A7FF" Margin="0,12,0,35"/>
                    <Button Content="⌂   Dashboard" HorizontalContentAlignment="Left" Background="#17305A" Click="Dashboard_Click"/>
                    <Button Content="◈   Performance Presets" HorizontalContentAlignment="Left" Click="Presets_Click"/>
                    <Button Content="🎮   Game Profiles" HorizontalContentAlignment="Left" Click="Games_Click"/>
                    <Button Content="⚙   System Scan" HorizontalContentAlignment="Left" Click="Scan_Click"/>
                    <Button Content="↶   Restore Center" HorizontalContentAlignment="Left" Click="Restore_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#0D1E2C" BorderBrush="#176C66" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="✓  SAFETY FIRST" Foreground="#46E0B4" FontWeight="Bold"/>
                        <TextBlock Text="Security services and thermal protections are never disabled." Foreground="#92A5C9" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="6,0,6,10">
                <StackPanel>
                    <TextBlock Text="Performance Dashboard" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Live hardware telemetry · safe presets · game detection" Foreground="#92A5C9" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OsBadge" Text="Windows · checking..." Foreground="#92A5C9" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Scan system" Click="Scan_Click" Background="#205DCA"/>
                </StackPanel>
            </DockPanel>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel><TextBlock Text="PROCESSOR" Foreground="#92A5C9" FontSize="11"/><TextBlock x:Name="CpuValue" Text="Scanning…" FontSize="16" FontWeight="Bold" Margin="0,8,0,3" TextWrapping="Wrap"/><TextBlock x:Name="CpuLoadValue" Text="CPU load: —" Foreground="#92A5C9" FontSize="11"/><ProgressBar x:Name="CpuBar" Height="7" Maximum="100" Value="0" Foreground="#287BFF" Background="#1B2942" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel><TextBlock Text="MEMORY" Foreground="#92A5C9" FontSize="11"/><TextBlock x:Name="RamValue" Text="Scanning…" FontSize="18" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock x:Name="RamSub" Text="Installed RAM" Foreground="#92A5C9" FontSize="11"/><ProgressBar x:Name="RamBar" Height="7" Maximum="100" Value="0" Foreground="#773BFF" Background="#1B2942" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel><TextBlock Text="GPU LOAD / TEMP" Foreground="#92A5C9" FontSize="11"/><TextBlock x:Name="GpuLoadValue" Text="Unavailable" FontSize="18" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock x:Name="GpuTempValue" Text="Temperature unavailable" Foreground="#92A5C9" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="GpuNameValue" Text="GPU: scanning…" Foreground="#92A5C9" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel><TextBlock Text="POWER PLAN" Foreground="#92A5C9" FontSize="11"/><TextBlock x:Name="PowerValue" Text="Checking…" FontSize="18" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Current Windows plan" Foreground="#92A5C9" FontSize="11"/><TextBlock x:Name="WindowsValue" Text="Windows" Foreground="#92A5C9" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Game Profiles" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Choose a game and a profile. Game-specific graphics settings are not changed in this build." Foreground="#92A5C9" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <UniformGrid Columns="3">
                                <Border Background="#111D34" BorderBrush="#2A4778" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3">
                                    <StackPanel><TextBlock Text="COUNTER-STRIKE 2" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="Competitive FPS" Foreground="#92A5C9" Margin="0,5,0,12" FontSize="11"/><ComboBox x:Name="CsPreset" SelectedIndex="0" Padding="5"><ComboBoxItem Content="MAX FPS"/><ComboBoxItem Content="LOW LATENCY"/><ComboBoxItem Content="BALANCED"/></ComboBox><Button Content="Apply profile" Tag="CS2" Click="ApplyGameProfile_Click" Background="#245FDB"/></StackPanel>
                                </Border>
                                <Border Background="#111D34" BorderBrush="#2A4778" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3">
                                    <StackPanel><TextBlock Text="FORTNITE" FontWeight="Bold" FontSize="13"/><TextBlock Text="Battle Royale" Foreground="#92A5C9" Margin="0,5,0,12" FontSize="11"/><ComboBox x:Name="FortPreset" SelectedIndex="0" Padding="5"><ComboBoxItem Content="MAX FPS"/><ComboBoxItem Content="LOW LATENCY"/><ComboBoxItem Content="BALANCED"/></ComboBox><Button Content="Apply profile" Tag="Fortnite" Click="ApplyGameProfile_Click" Background="#245FDB"/></StackPanel>
                                </Border>
                                <Border Background="#111D34" BorderBrush="#2A4778" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3">
                                    <StackPanel><TextBlock Text="VALORANT" FontWeight="Bold" FontSize="13"/><TextBlock Text="Tactical FPS" Foreground="#92A5C9" Margin="0,5,0,12" FontSize="11"/><ComboBox x:Name="ValPreset" SelectedIndex="0" Padding="5"><ComboBoxItem Content="MAX FPS"/><ComboBoxItem Content="LOW LATENCY"/><ComboBoxItem Content="BALANCED"/></ComboBox><Button Content="Apply profile" Tag="Valorant" Click="ApplyGameProfile_Click" Background="#245FDB"/></StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Performance Presets" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Changes the Windows power plan only. Results depend on hardware and workload." Foreground="#92A5C9" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel><Button Content="⚡ MAXIMUM FPS" Background="#245FDB" Click="MaxFps_Click"/><Button Content="◈ BALANCED" Background="#243653" Click="Balanced_Click"/><Button Content="↶ RESTORE PREVIOUS" Background="#3B285C" Click="Restore_Click"/></WrapPanel>
                            <TextBlock x:Name="PlanDetails" Text="Power plan details will appear after scanning." Foreground="#92A5C9" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Live Samples" Style="{StaticResource SectionTitle}"/><TextBlock Text="Recent CPU and RAM samples (last 30 readings)" Foreground="#92A5C9" FontSize="11"/><ListBox x:Name="SamplesList" Height="100" Background="#080F20" Foreground="#B9C9E8" BorderBrush="#1C3157"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}"/><ListBox x:Name="LogList" Height="90" Background="#080F20" Foreground="#B9C9E8" BorderBrush="#1C3157"/></StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Active Profile" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ActiveProfileText" Text="No game profile applied" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/><TextBlock Text="Windows Power Plan" Foreground="#92A5C9"/><TextBlock x:Name="ActivePlanText" Text="Checking…" Margin="0,3,0,12" FontWeight="SemiBold"/><Separator Background="#1C3157" Margin="0,0,0,10"/><TextBlock Text="FPS / Frame time" Foreground="#92A5C9"/><TextBlock Text="Not connected to a supported frame telemetry source." TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="No FPS values are fabricated. PresentMon integration is planned for a future version." Foreground="#92A5C9" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Detected Games" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DetectedGamesText" Text="No supported game detected." TextWrapping="Wrap"/><TextBlock Text="Detection is based on process names; game settings are not modified." Foreground="#92A5C9" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}"/><Button Content="Scan system" Click="Scan_Click" HorizontalContentAlignment="Left"/><Button Content="Show available power plans" Click="ShowPlans_Click" HorizontalContentAlignment="Left"/><Button Content="Restore previous power plan" Click="Restore_Click" HorizontalContentAlignment="Left"/><Button Content="Open Windows Power settings" Click="OpenPowerSettings_Click" HorizontalContentAlignment="Left"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel><TextBlock Text="Safety status" Style="{StaticResource SectionTitle}"/><TextBlock Text="● System settings protected" Foreground="#46E0B4" FontWeight="Bold"/><TextBlock Text="No security services disabled, no registry tweaks, no process termination, no overclocking." Foreground="#92A5C9" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="3" Text="NEXUS BOOST · v3 · Live CPU/RAM · GPU sensors when supported · no guaranteed FPS increase" Foreground="#667DA5" Margin="8,7,0,0" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
